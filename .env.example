# Copia este archivo a .env y ajusta los valores (todos son opcionales).
SIGMA_HOST=127.0.0.1
SIGMA_PORT=5000
# Archivo SQLite que se usa cuando no se ha elegido otra base. Por defecto: instance/sigma.db
# SIGMA_DB_PATH=D:\IA\Sigma\instance\sigma.db
# Base de datos de Sigma (tiene prioridad sobre lo elegido en la interfaz). Motores: SQLite, SQL Server, MySQL/MariaDB,
# PostgreSQL, Oracle y MongoDB. Ejemplos:
# SIGMA_DATABASE_URL=postgresql+psycopg://usuario:clave@servidor/sigma
# SIGMA_DATABASE_URL=mssql+pyodbc://usuario:clave@servidor/sigma?driver=ODBC+Driver+18+for+SQL+Server
# SIGMA_DATABASE_URL=mysql+pymysql://usuario:clave@servidor/sigma
# SIGMA_DATABASE_URL=oracle+oracledb://usuario:clave@servidor:1521/?service_name=FREEPDB1
# SIGMA_DATABASE_URL=mongodb://usuario:clave@servidor:27017/sigma
SIGMA_SECRET_KEY=cambia-esta-clave
SIGMA_MAX_UPLOAD_MB=100
SIGMA_CELL_TIMEOUT_SECONDS=60

# --- Cuentas de usuario -------------------------------------------------------
# Horas que dura una sesion abierta (por defecto 12).
# SIGMA_SESSION_HOURS=12
# Pon 1 cuando Sigma se sirva por HTTPS (la cookie de sesion solo viajara cifrada).
# SIGMA_SECURE_COOKIES=1
# Para usarlo en red: SIGMA_HOST=0.0.0.0 y lista los nombres con los que se accede.
# Las contrasenas viajan en claro por HTTP: usa HTTPS con un proxy inverso.
# SIGMA_ALLOWED_HOSTS=sigma.miempresa.local

# --- Consola Python (kernels) -------------------------------------------------
# Un usuario con permiso de consola ejecuta codigo con los permisos del sistema.
# SIGMA_MAX_KERNELS_PER_USER=3
# SIGMA_MAX_KERNELS_TOTAL=8

# --- Lectura de bases de datos externas (Datos > Base de datos) ---------------------
# Servidores a los que se puede conectar para importar (separados por comas). Vacio = cualquiera.
# SIGMA_EXTERNAL_DB_HOSTS=bd.miempresa.local,reportes.miempresa.local

# --- Importaciones pendientes (archivo subido + vista previa) -------------------
# SIGMA_DRAFT_RETENTION_DAYS=14

# --- Interpretacion con IA (opcional) -----------------------------------------
# Clave de API del servidor (tambien puede guardarse desde Usuarios > Interpretacion con IA).
# ANTHROPIC_API_KEY=
# SIGMA_AI_REQUESTS_PER_HOUR=20
# SIGMA_AI_MODEL=claude-opus-5-5
