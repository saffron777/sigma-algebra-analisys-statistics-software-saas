# Copia este archivo a .env y ajusta los valores (todos son opcionales).
SIGMA_HOST=127.0.0.1
SIGMA_PORT=5000
# Ruta de la base SQLite (datasets + resultados). Por defecto: instance/sigma.db
# SIGMA_DB_PATH=D:\IA\Sigma\instance\sigma.db
SIGMA_SECRET_KEY=cambia-esta-clave
SIGMA_MAX_UPLOAD_MB=100
SIGMA_CELL_TIMEOUT_SECONDS=60
