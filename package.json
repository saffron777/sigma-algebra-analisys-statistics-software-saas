{
  "name": "sigma-algebra-analisys-statistics-software-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Sigma Algebra Analisys Statistics Software (SAAS) - plataforma web de estadística",
  "license": "AGPL-3.0-or-later",
  "author": "Frank Miranda",
  "homepage": "https://github.com/saffron777/sigma-algebra-analisys-statistics-software-saas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saffron777/sigma-algebra-analisys-statistics-software-saas.git"
  },
  "bugs": {
    "url": "https://github.com/saffron777/sigma-algebra-analisys-statistics-software-saas/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "copy:vendor": "node scripts/copy_vendor.mjs",
    "build:css": "tailwindcss -i sigma/presentation/web/static/src/input.css -o sigma/presentation/web/static/css/app.css --minify",
    "watch:css": "tailwindcss -i sigma/presentation/web/static/src/input.css -o sigma/presentation/web/static/css/app.css --watch",
    "build": "npm run copy:vendor && npm run build:css",
    "postinstall": "npm run copy:vendor"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "alpinejs": "^3.14.0",
    "dompurify": "^3.1.0",
    "jspreadsheet-ce": "^5.0.4",
    "katex": "^0.19.0",
    "marked": "^12.0.0",
    "plotly.js-dist-min": "^4.1.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
